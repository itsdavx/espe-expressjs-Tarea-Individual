// Esquema de PostgreSQL · Tarea U2, caso 2 · Gimnasio
// Lo transaccional vive aquí: User (login) e Inscripcion (cupo).
// El catálogo (Clase) y las valoraciones viven en MongoDB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  password      String
  role          Role
  inscripciones Inscripcion[]
}

model Inscripcion {
  id          Int               @id @default(autoincrement())
  user        User              @relation(fields: [userId], references: [id])
  userId      Int
  // _id de la Clase en MongoDB (24 hex). Sin FK: lo valida el servicio.
  claseId     String?
  fechaSesion DateTime
  estado      EstadoInscripcion @default(ACTIVA)
  createdAt   DateTime          @default(now())

  // Une el historial con el catálogo y protege el borrado de una clase.
  @@index([claseId])
  // Un socio no se inscribe dos veces en la misma sesión.
  @@unique([userId, claseId, fechaSesion])
}

enum Role {
  ADMIN
  USER
}

enum EstadoInscripcion {
  ACTIVA
  CANCELADA
}
